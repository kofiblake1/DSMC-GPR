# ---- Data: never commit; it lives on the cluster, referenced via registry.yaml ----
# (registry.yaml itself IS committed — it's just paths/provenance)
*.pkl
*.pickle
*.h5
*.hdf5
*.npy
*.npz
*.vtk
*.vtu
*.plt
*.dat
# Exclude the directory's *contents*, not the directory itself: git cannot
# re-include a file whose parent directory is excluded, so a bare `data/` here
# would silently defeat both negations below (registry.yaml was never committed
# for exactly this reason). Verify with: git check-ignore -v data/registry.yaml
data/*
!data/README.md
!data/registry.yaml

# ---- SPARTA / AERO-F run artifacts & large outputs ----
*.log
dump.*
log.*
*.restart
*.surf
*.grid
runs/
outputs/
results/
*.out

# ---- Notebook cruft ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Python packaging / caches ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints

# ---- Virtual environments ----
.venv/
venv/
env/
.conda/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.swp
*~

# ---- Figures: usually regenerated; keep out unless a figure is a deliverable ----
*.png
*.pdf
*.jpg
*.jpeg
!docs/**/*.png
!docs/**/*.pdf
